[Unit]
Description=Wazuh SMS alerter (Africa's Talking)
After=wazuh-manager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wazuh-sms
Group=wazuh
EnvironmentFile=/etc/wazuh-bundle/sms.env
ExecStart=/usr/bin/python3 /usr/local/bin/wazuh-sms-alerter.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/ossec/logs

[Install]
WantedBy=multi-user.target
